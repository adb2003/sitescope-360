# SiteScope 360 — environment template (§38)
# Copy to `.env` and adjust. Never commit a real `.env` (§44).

# ---- application -------------------------------------------------------------
APP_NAME="SiteScope 360"
ENVIRONMENT=development          # development | test | production
DEBUG=true
API_PREFIX=/api
# Used to build signed asset URLs. Must be the URL the browser reaches the API on.
PUBLIC_BASE_URL=http://localhost:8000
# 5173/4173 are the web frontend (dev/preview); 8081 is the Expo mobile app running under
# `npm run web --prefix mobile`, which is a desktop inspection target, not a deployment target.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8081,http://127.0.0.1:8081

# ---- database ----------------------------------------------------------------
# Production target. Docker Compose sets this automatically.
# DATABASE_URL=postgresql+psycopg://sitescope:sitescope@localhost:5432/sitescope
# Local development without Docker (see docs/DEVELOPMENT.md):
DATABASE_URL=sqlite:///./var/dev.db
DB_ECHO=false

# ---- authentication ----------------------------------------------------------
# CHANGE BOTH BEFORE ANY DEPLOYMENT. 32+ random bytes each, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# Strict-Transport-Security lifetime, in seconds; 0 sends no header, and it is only ever sent on
# a request that arrived over HTTPS. Switch it on once the deployment is entirely on TLS and not
# before: this is the one security header that cannot be taken back, because a browser that saw
# it will refuse the plain-HTTP host for this long and no later response can shorten it.
# HSTS_MAX_AGE_SECONDS=31536000

# ---- storage -----------------------------------------------------------------
STORAGE_BACKEND=local            # local | s3
STORAGE_ROOT=./var/storage
STORAGE_URL_TTL_SECONDS=3600
STORAGE_SIGNING_SECRET=dev-only-insecure-signing-secret

# Only needed when STORAGE_BACKEND=s3 (also: uv pip install boto3)
# S3_BUCKET=sitescope-captures
# S3_REGION=eu-west-2
# S3_ENDPOINT_URL=                 # set for MinIO / other S3-compatible services
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Serve assets from a CDN instead of the storage origin. Only the scheme, host and any path
# prefix are replaced; the signed query string is carried through untouched. With S3 the
# distribution must use the same S3 endpoint as its origin and forward X-Amz-* unmodified,
# because SigV4 signs the Host header.
# CDN_BASE_URL=https://cdn.example.com

# ---- uploads -----------------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648       # 2 GiB
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov
ALLOWED_FLOORPLAN_EXTENSIONS=.png,.jpg,.jpeg,.pdf

# ---- job queue ---------------------------------------------------------------
# `redis` is the production backend (durable, multi-worker).
# `thread` runs an in-process pool so the platform works with no Redis installed —
# convenient locally, but queued work is lost if the API restarts.
QUEUE_BACKEND=thread              # thread | redis
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=sitescope
THREAD_QUEUE_WORKERS=2

# ---- processing --------------------------------------------------------------
FRAME_INTERVAL_SECONDS=1.0        # video → one frame every N seconds (§9). Measured: 2.0 put
                                  # 2.4 m between frames and cost ~6x track accuracy.
MAX_FRAMES_PER_VIDEO=600
THUMBNAIL_WIDTH=256
PREVIEW_WIDTH=1024
ORB_FEATURES=1200
# Below this median confidence an automatic capture path is refused and manual
# placement is required instead (§14, §46). Raise it to be stricter.
MAPPING_CONFIDENCE_THRESHOLD=0.45

# ---- monitoring --------------------------------------------------------------
DEFAULT_EXPECTED_CAPTURES_PER_WEEK=2

# ---- frontend ----------------------------------------------------------------
# Consumed by Vite at build time (must be prefixed VITE_).
VITE_API_BASE_URL=http://localhost:8000
