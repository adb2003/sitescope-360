{
  "name": "sitescope-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SiteScope 360 — offline-first 360 capture app (Expo / React Native)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "expo start --web --port 8081"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-location": "~18.0.2",
    "expo-network": "~7.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.3",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.2",
    "vitest": "^3"
  }
}
